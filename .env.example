# =============================================================================
# RailOptix — Production Environment Variables
# =============================================================================

# 1. APPLICATION RUNTIME
ENVIRONMENT=production
DEBUG=false
APP_NAME=RailOptix
VERSION=2.0.0

# 2. MANAGED POSTGRESQL DATABASE URI
DATABASE_URL=

# Database Connection Pool Tuning
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30

# 3. JWT AUTHENTICATION SECRET KEY
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 4. GOOGLE GEMINI AI LLM API KEY
GEMINI_API_KEY=

# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
CORS_ORIGINS=

# 6. FRONTEND API TARGET
VITE_API_URL=
